  {
   "id": "n_formula",
   "type": "prep.formula",
   "label": "ARR e tier",
   "x": 536.0,
   "y": 70.0,
   "config": {
    "formulas": [
     {
      "column": "receita_anual",
      "type": "Float64",
      "expression": "Round([mrr_mensal] * 12, 2)"
     },
     {
      "column": "tier",
      "type": "String",
      "expression": "IF [mrr_mensal] >= 6000 THEN 'Diamond' ELSEIF [mrr_mensal] >= 3000 THEN 'Gold' ELSE 'Silver' ENDIF"
     }
    ]
   },
   "disabled": false,
   "cache_point": false,
   "cache_refresh": "changes"
  },
