   "id": "x_sum",
   "type": "transform.summarize",
   "x": 700,
   "y": 3000,
   "config": {
    "group_by": [
     "uf"
    ],
    "aggregations": [
     {
      "column": "mrr_mensal",
      "agg": "sum",
      "name": "t"
     },
     {
      "column": "mrr_mensal",
      "agg": "median",
      "name": "m"
     },
     {
      "column": "segmento",
      "agg": "n_unique",
      "name": "u"
     },
     {
      "column": "segmento",
      "agg": "mode",
      "name": "mo"
     }
    ]
   }
  },
