{
 "id": "demo_pipeline_360",
 "name": "Pipeline 360° de clientes",
 "description": "Limpeza, filtro, junção L/J/R, metas regionais (CSV ';' em CP1252), BI e modelo de inadimplência.",
 "containers": [
  {
   "id": "c_prep",
   "title": "1 · Ingestão e preparação",
   "color": "#3b82f6",
   "x": 20,
   "y": 20,
   "width": 972,
   "height": 260
  },
  {
   "id": "c_bi",
   "title": "2 · Junção, metas e indicadores",
   "color": "#8b5cf6",
   "x": 1010,
   "y": 20,
   "width": 1222,
   "height": 420
  },
  {
   "id": "c_ml",
   "title": "3 · Modelo de inadimplência",
   "color": "#06b6d4",
   "x": 1010,
   "y": 460,
   "width": 1222,
   "height": 140
  },
  {
   "id": "c_vendas",
   "title": "4 · Vendas no dashboard",
   "color": "#f59e0b",
   "x": 20,
   "y": 300,
   "width": 972,
   "height": 300
  }
 ],
 "nodes": [
  {
   "id": "n_clientes",
   "type": "io.input_data",
   "label": "Clientes",
   "x": 40,
   "y": 70,
   "config": {
    "dataset": "clientes_enterprise.csv"
   }
  },
  {
   "id": "n_vendas",
   "type": "io.input_data",
   "label": "Transações",
   "x": 40,
   "y": 190,
   "config": {
    "dataset": "transacoes_vendas.csv"
   }
  },
  {
   "id": "n_cleanse",
   "type": "prep.cleanse",
   "label": "Limpeza",
   "x": 288,
   "y": 70,
   "config": {
    "columns": [
     "setor"
    ],
    "replace_null_string": true,
    "string_default": "Não informado"
   }
  },
  {
   "id": "n_formula",
   "type": "prep.formula",
   "label": "ARR e tier",
   "x": 536,
   "y": 70,
   "config": {
    "formulas": [
     {
      "column": "receita_anual",
      "type": "Float64",
      "expression": "Round([mrr_mensal] * 12, 2)"
     },
     {
      "column": "tier",
      "type": "String",
      "expression": "IF [mrr_mensal] >= 6000 THEN 'Diamond' ELSEIF [mrr_mensal] >= 3000 THEN 'Gold' ELSE 'Silver' ENDIF"
     }
    ]
   }
  },
  {
   "id": "n_filter",
   "type": "prep.filter",
   "label": "Ativos",
   "x": 784,
   "y": 70,
   "config": {
    "mode": "expression",
    "expression": "[status] != 'INATIVO' AND [mrr_mensal] >= 1000"
   }
  },
  {
   "id": "n_sum_vendas",
   "type": "transform.summarize",
   "label": "Vendas por cliente",
   "x": 536,
   "y": 190,
   "config": {
    "group_by": [
     "id_cliente"
    ],
    "aggregations": [
     {
      "column": "valor_bruto",
      "agg": "sum",
      "alias": "total_compras"
     },
     {
      "column": "quantidade_licencas",
      "agg": "sum",
      "alias": "total_licencas"
     },
     {
      "column": "id_transacao",
      "agg": "count",
      "alias": "qtd_pedidos"
     }
    ]
   }
  },
  {
   "id": "n_join",
   "type": "transform.join",
   "label": "Clientes × vendas",
   "x": 1032,
   "y": 125,
   "config": {
    "right_prefix": "v_",
    "keys": [
     {
      "left": "id_cliente",
      "right": "id_cliente"
     }
    ]
   }
  },
  {
   "id": "n_sum_uf",
   "type": "transform.summarize",
   "label": "MRR por UF",
   "x": 1280,
   "y": 65,
   "config": {
    "group_by": [
     "uf"
    ],
    "aggregations": [
     {
      "column": "mrr_mensal",
      "agg": "sum",
      "alias": "total_mrr"
     },
     {
      "column": "id_cliente",
      "agg": "count",
      "alias": "clientes"
     }
    ]
   }
  },
  {
   "id": "n_metas",
   "type": "io.input_data",
   "label": "Metas regionais",
   "x": 1280,
   "y": 165,
   "config": {
    "dataset": "metas_regionais_br.csv"
   }
  },
  {
   "id": "n_join_metas",
   "type": "transform.join",
   "label": "UF × metas",
   "x": 1528,
   "y": 100,
   "config": {
    "keys": [
     {
      "left": "uf",
      "right": "uf"
     }
    ]
   }
  },
  {
   "id": "n_atingimento",
   "type": "prep.formula",
   "label": "Atingimento",
   "x": 1776,
   "y": 108,
   "config": {
    "formulas": [
     {
      "column": "atingimento_pct",
      "type": "Float64",
      "expression": "Round([total_mrr] / [meta_mrr] * 100, 1)"
     }
    ]
   }
  },
  {
   "id": "n_chart_uf",
   "type": "bi.chart",
   "label": "Gráfico por UF",
   "x": 2024,
   "y": 108,
   "config": {
    "title": "Atingimento da meta de MRR por UF (%)",
    "chart_type": "bar",
    "x_column": "uf",
    "y_column": "atingimento_pct",
    "agg": "max",
    "sort": "value_desc"
   }
  },
  {
   "id": "n_kpi",
   "type": "bi.kpi_card",
   "label": "ARR ativo",
   "x": 1280,
   "y": 270,
   "config": {
    "title": "ARR dos clientes ativos",
    "column": "receita_anual",
    "metric": "sum",
    "prefix": "R$ "
   }
  },
  {
   "id": "n_chart_seg",
   "type": "bi.chart",
   "label": "MRR por segmento",
   "x": 1280,
   "y": 360,
   "config": {
    "title": "MRR por segmento",
    "chart_type": "donut",
    "x_column": "segmento",
    "y_column": "mrr_mensal",
    "agg": "sum"
   }
  },
  {
   "id": "n_pareto",
   "type": "bi.chart",
   "label": "Pareto por UF",
   "x": 1528,
   "y": 300,
   "config": {
    "title": "Pareto do MRR por UF",
    "chart_type": "pareto",
    "x_column": "uf",
    "y_column": "mrr_mensal",
    "agg": "sum"
   }
  },
  {
   "id": "n_kpi_mes",
   "type": "bi.kpi_card",
   "label": "Faturamento do mês",
   "x": 288,
   "y": 350,
   "config": {
    "title": "Faturamento do mês",
    "column": "valor_bruto",
    "metric": "sum",
    "prefix": "R$ ",
    "compare": "previous",
    "date_column": "competencia",
    "period": "month",
    "sparkline": true
   }
  },
  {
   "id": "n_stacked",
   "type": "bi.chart",
   "label": "Vendas por mês",
   "x": 536,
   "y": 350,
   "config": {
    "title": "Faturamento mensal por produto",
    "chart_type": "stacked",
    "x_column": "competencia",
    "y_column": "valor_bruto",
    "series_column": "produto",
    "agg": "sum",
    "sort": "label"
   }
  },
  {
   "id": "n_venn",
   "type": "bi.venn",
   "label": "Produtos por cliente",
   "x": 288,
   "y": 480,
   "config": {
    "title": "Clientes por produto contratado",
    "key_column": "id_cliente",
    "group_column": "produto",
    "groups": [
     "Cloud",
     "AutoML",
     "BI Pro"
    ]
   }
  },
  {
   "id": "n_trainer",
   "type": "ml.automl_trainer",
   "label": "Treino",
   "x": 1280,
   "y": 510,
   "config": {
    "target_column": "inadimplente",
    "feature_columns": [
     "mrr_mensal",
     "meses_contrato",
     "nps",
     "total_compras",
     "total_licencas",
     "segmento",
     "uf"
    ]
   }
  },
  {
   "id": "n_predictor",
   "type": "ml.predictor",
   "label": "Score de risco",
   "x": 1528,
   "y": 510,
   "config": {
    "prediction_column": "risco_inadimplencia",
    "probability_column": "confianca_pct"
   }
  },
  {
   "id": "n_output",
   "type": "io.output_data",
   "label": "Exportar",
   "x": 1776,
   "y": 510,
   "config": {
    "filename": "clientes_pontuados",
    "format": "parquet"
   }
  }
 ],
