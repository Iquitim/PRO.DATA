# Copie para .env e ajuste. Todas as variáveis são opcionais.
PRODATA_HOST=127.0.0.1
PRODATA_PORT=8765
PRODATA_RELOAD=false
PRODATA_LOG_LEVEL=INFO
PRODATA_STORAGE_DIR=./storage
PRODATA_MAX_UPLOAD_MB=200
PRODATA_SEED_SAMPLES=true
PRODATA_CORS_ORIGINS=["http://127.0.0.1:8765","http://localhost:8765"]
